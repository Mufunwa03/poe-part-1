            {
              "name": "Upload Staff Document",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst jsonData = pm.response.json();\r\n\r\npm.test(\"Response contains file name\", function () {\r\n    pm.expect(jsonData).to.have.property(\"fileName\");\r\n});\r\n\r\npm.test(\"Response contains file size\", function () {\r\n    pm.expect(jsonData).to.have.property(\"fileSize\");\r\n});\r\n\r\npm.test(\"Response contains content type\", function () {\r\n    pm.expect(jsonData).to.have.property(\"contentType\");\r\n    pm.expect(jsonData.contentType).to.eql(\"application/pdf\");\r\n});\r\n\r\npm.test(\"Response contains upload date\", function () {\r\n    pm.expect(jsonData).to.have.property(\"uploadedOn\");\r\n});\r\n\r\npm.collectionVariables.set(\"uploadedFileName\", jsonData.fileName);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": [
                        "Student_Library_Management_System_Task.pdf"
                      ]
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/documents/upload",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "documents",
                    "upload"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "List Staff Documents",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst jsonData = pm.response.json();\r\n\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(jsonData).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Uploaded document is listed\", function () {\r\n    const uploadedFileName = pm.collectionVariables.get(\"fileName\");\r\n\r\n    const documentExists = jsonData.some(function (document) {\r\n        return document.FileName === uploadedFileName;\r\n    });\r\n\r\n    pm.expect(documentExists).to.eql(true);\r\n});\r\n\r\npm.test(\"Document contains required metadata\", function () {\r\n    const uploadedFileName = pm.collectionVariables.get(\"fileName\");\r\n\r\n    const document = jsonData.find(function (item) {\r\n        return item.FileName === uploadedFileName;\r\n    });\r\n\r\n    pm.expect(document).to.have.property(\"FileName\");\r\n    pm.expect(document).to.have.property(\"FileSize\");\r\n    pm.expect(document).to.have.property(\"ContentType\");\r\n    pm.expect(document).to.have.property(\"UploadedOn\");\r\n});"
                    ]
                  }
                }
              ],
